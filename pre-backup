#!/bin/bash
# pre-backup -- OPTIONAL per-host hook, run by restic-backup.sh immediately
# before `restic backup`. EMPTY BY DEFAULT. It exists so a host can prepare
# something the declarative config cannot express.
#
# ROUTINE DATABASE DUMPS DO NOT BELONG HERE. Declare them in the config and the
# main script dumps them natively:
#     MARIADB_LOCAL=(ALL)                # or (db1 db2)
#     POSTGRES_LOCAL=(mydb)              # or (ALL)
#     DOCKER_AUTO=(app-mariadb)          # detects the engine, dumps everything
#     SQLITE_FILES=(vaultwarden:/srv/vaultwarden/data/db.sqlite3)
#
# Use this file only for the leftovers, e.g.:
#     - an app-specific export with no native support (LDAP, etcd, a REST dump)
#     - quiescing something first (systemctl stop / docker pause)
#     - a container whose DB password lives in a HOST secret file rather than in
#       the container's own environment (DOCKER_AUTO reads the container's env)
#     - SQLite that exists only inside a container and is not bind-mounted
#
# CONTRACT WITH THE MAIN SCRIPT
#   - $DUMP_DIR is exported by the main script. It exists, is mode 0700, and has
#     already been emptied. Anything written there is included in the snapshot.
#   - The main script WIPES $DUMP_DIR on exit. Do NOT clean it yourself -- you
#     would delete the dumps the native stage just produced -- and do not write
#     anything here that you expect to survive the run.
#   - MUST exit non-zero if ANYTHING fails. The main script then aborts the whole
#     backup and alerts: better no backup than a silently incomplete one.
#   - Owns nothing else: no restic, no knowledge of the repo, no cleanup.
#   - Must be installed at $CONFIG_DIR/pre-backup AND be executable, or it is
#     skipped entirely. Hosts with nothing to prepare just omit the file.
#
# Secrets come from the host ENVIRONMENT, never from argv (argv is world-visible
# in the process list). Put them in a root-only file and `source` it.
#
# Standalone test:  DUMP_DIR=/tmp/dumptest ./pre-backup && ls -l /tmp/dumptest
# =============================================================================
set -euo pipefail
umask 077                                  # artifacts may be plaintext -> 0600
export PATH="/usr/local/bin:/usr/bin:/bin:${PATH:-}"

DUMP_DIR="${DUMP_DIR:-$HOME/.config/restic/db-dumps}"   # default is for standalone runs only
mkdir -p "$DUMP_DIR"; chmod 700 "$DUMP_DIR"

log() { printf '%s pre-backup: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*"; }
die() { log "ERROR: $*"; exit 1; }

# dump_to <name> <command...>  -- the one primitive worth keeping.
# Runs the command, captures STDOUT to $DUMP_DIR/<name>.out atomically, and fails
# loudly on a non-zero exit OR empty output (a silently truncated dump is the
# failure mode this whole script exists to prevent). Prefer UNCOMPRESSED output:
# restic dedups it well across runs, and $DUMP_DIR never outlives the snapshot.
# stderr is left to flow to our stderr, which the main script captures on failure.
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
dump_to() {
  local name; name="$(slug "$1")"; shift
  local out="$DUMP_DIR/$name.out" tmp="$DUMP_DIR/$name.out.tmp"
  log "writing -> $(basename "$out")"
  "$@" >"$tmp" || die "'$name' failed (exit $?)"
  [[ -s "$tmp" ]] || die "'$name' produced an empty file"
  mv -f "$tmp" "$out"
}

# =============================================================================
# WHAT TO PREPARE  --  the ONLY part you edit per host. Empty = nothing to do.
#
# Examples (all commented out; delete or adapt):
#
#   # SQLite that lives only inside a container:
#   dump_to "grafana" docker exec grafana sqlite3 /var/lib/grafana/grafana.db .dump
#
#   # Container DB whose password comes from a host secret, forwarded BY NAME so
#   # it never reaches the host process list:
#   export MYSQL_PWD="$(cat /root/.secrets/mariadb_pw)"
#   dump_to "appdb" docker exec -e MYSQL_PWD app-mariadb \
#       mariadb-dump --single-transaction --quick --routines --events -uroot appdb
#   unset MYSQL_PWD
#
#   # Something that is not a database at all:
#   dump_to "ldap" slapcat -n 1
#
# List running containers:  docker ps --format '{{.Names}}\t{{.Image}}'
# =============================================================================

log "hook finished."
