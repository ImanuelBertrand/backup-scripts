# =============================================================================
# deploy.conf -- which machines ./deploy.sh pushes to
# -----------------------------------------------------------------------------
#     install -d -m 700 ~/.config/restic
#     cp deploy.conf.sample ~/.config/restic/deploy.conf
#     $EDITOR ~/.config/restic/deploy.conf
#
# It belongs in ~/.config/restic and not in the checkout: this describes one
# production fleet, while the checkout is code -- cloned, cleaned, and checked
# out a second time. deploy.sh reads that path alone (DEPLOY_CONF=... overrides
# it) and refuses to run at all while a copy sits in the checkout, so an edit
# cannot land in a file nothing loads.
#
# Nothing in here is secret, but it is site-specific: hostnames, paths, and the
# cron minute each host gets. Sourced as plain bash.
# =============================================================================

# Every entry is passed to ssh/scp verbatim, so a bare hostname, a
# ~/.ssh/config alias, or "user@host" all work.
HOSTS=(
  srv01
  srv02
  pc.lan
  laptop.lan
)

# Prepended when a HOSTS entry has no "user@".
SSH_USER="root"

# deploy.sh needs root on the target: it writes /usr/local/sbin and /etc/cron.d,
# and reads, hashes and diffs CONFIG_DIR under /root. When SSH_USER is not root,
# every remote command is run through this prefix.
#
# It must be PASSWORDLESS. SSH_OPTS below uses BatchMode, so there is no
# terminal on which to answer a prompt, and "sudo -n" fails immediately instead
# of hanging -- which deploy.sh reports as a sudo failure, not an unreachable
# host. On the target:
#     echo 'youruser ALL=(root) NOPASSWD: ALL' > /etc/sudoers.d/deploy-restic
#     chmod 440 /etc/sudoers.d/deploy-restic
# Where root logs in over ssh directly, this is ignored (nothing to elevate).
SUDO="sudo -n"

# BatchMode makes an unreachable or passphrase-prompting host fail fast instead
# of hanging the whole run.
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)

# ---- Where things live ON THE TARGET ----------------------------------------
SBIN_PATH="/usr/local/sbin/restic-backup.sh"
CONFIG_DIR="/root/.config/restic"
CRON_PATH="/etc/cron.d/restic-backup"

# ---- Per-host cron minute ---------------------------------------------------
# A host listed here gets restic-backup.cron rendered with ITS minute (and the
# paths above) and installed. A host NOT listed keeps whatever cron entry it
# already has -- deploy.sh will not touch it.
#
# GIVE EVERY HOST A DIFFERENT VALUE. It staggers them off the repo lock, and
# unlike a random delay you can see the whole fleet's spread right here.
declare -A CRON_MINUTE=(
  [srv01]=07
  [srv02]=23
  [pc.lan]=41
  [laptop.lan]=53
)

# -----------------------------------------------------------------------------
# NEVER deployed, by design:
#   config, encryption-pw  -- secrets, different on every host, hand-managed
#   pre-backup             -- per-host hook, hand-managed
# -----------------------------------------------------------------------------
